# Frontend
VITE_API_BASE_URL=http://127.0.0.1:3000/api
VITE_SENTRY_DSN=

# Backend
SENTRY_DSN=
API_PORT=3000
API_HOST=127.0.0.1
API_CORS_ORIGIN=http://localhost:5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=radio_app
MYSQL_CONNECTION_LIMIT=10

# Used for /api/admin/* endpoints and import script
SERVICE_KEY=change-me

# Admin authentication for review endpoints
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN_TTL_SECONDS=28800

# Basic submission rate limiting
SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
SUBMISSION_RATE_LIMIT_MAX=5

# Image proxy in-memory cache
IMAGE_PROXY_CACHE_TTL_MS=600000
IMAGE_PROXY_CACHE_MAX_ITEMS=500

# Image proxy security and throttling
IMAGE_PROXY_RATE_LIMIT_WINDOW_MS=60000
IMAGE_PROXY_RATE_LIMIT_MAX=120
# Optional comma-separated allowlist, supports exact host and wildcard suffixes like *.example.com
IMAGE_PROXY_ALLOWED_HOSTS=
